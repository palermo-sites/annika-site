---
import { url, img } from '../lib';
const { piece } = Astro.props;
const g = piece.data.gallery[0];
---
<a class="card" href={url(`/portfolio/${piece.id}/`)}>
  <div class="frame"><img src={img(g.src)} alt={g.alt} width="400" height="560" loading="lazy"></div>
  <p class="meta">{piece.data.silhouette} · {piece.data.year}</p>
  <h3>{piece.data.title}</h3>
  <p>{piece.data.description}</p>
</a>
