---
import { url, img, fmtDate } from '../lib';
const { post } = Astro.props;
---
<a class="post-card" href={url(`/designs/${post.id}/`)}>
  <img src={img(post.data.image)} alt="" width="200" height="200" loading="lazy">
  <div>
    <p class="meta muted"><time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time> · {post.data.tags.join(', ')}</p>
    <h3>{post.data.title}</h3>
    <p class="muted">{post.data.description}</p>
  </div>
</a>
