---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PieceCard from '../../components/PieceCard.astro';
const pieces = (await getCollection('portfolio')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Portfolio" description="Finished couture wedding gowns by Annika Palermo: silhouettes, fabrics and details of each piece.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Portfolio</p>
      <h1>Finished pieces</h1>
      <p class="lead">Each gown here was designed and constructed in the studio, from toile to final pressing.</p>
    </header>
    <div class="grid three">{pieces.map((p) => <PieceCard piece={p} />)}</div>
  </div>
</Base>
