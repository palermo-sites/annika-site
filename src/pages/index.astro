---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
---
<Base
  title="Annika Palermo"
  description="Placeholder sketchbook of dress studies by Annika Palermo: a pencil drawing beside a finished study for each dress."
  home
  placeholder={projects.some((project) => project.data.placeholder)}
>
  {projects.length === 0 ? (
    <p class="empty">No studies yet. Add a Markdown file in the projects folder to place a dress on the grid.</p>
  ) : (
    <ul class="studies">
      {projects.map((project, index) => (
        <li><ProjectCard project={project} index={index} /></li>
      ))}
    </ul>
  )}
</Base>
