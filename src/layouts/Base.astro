---
interface Props { title: string; description?: string }
const { title, description = 'Annika Palermo' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.slice(base.length) || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={new URL(path, Astro.site)}>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
  </head>
  <body>
    <header>
      <nav>
        <a href={`${base}/`}>Home</a>
        <a href={`${base}/about/`}>About</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>&copy; {new Date().getFullYear()} Annika Palermo</footer>
  </body>
</html>
<style is:global>
  body { font-family: system-ui, sans-serif; margin: 0; color: #222; }
  header, main, footer { max-width: 48rem; margin: 0 auto; padding: 1rem; }
  nav a { margin-right: 1rem; }
  footer { color: #777; font-size: 0.9rem; }
</style>
