---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import { base, url } from '../lib';

interface Props { title: string; description?: string; image?: string; type?: string }
const { title, description = 'Annika Palermo designs couture wedding gowns by hand: sketches, fittings and finished pieces. Sample site.', image = '/images/og.png', type = 'website' } = Astro.props;
const path = Astro.url.pathname.slice(base.length) || '/';
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image, Astro.site);
const fullTitle = title === 'Annika Palermo' ? 'Annika Palermo · Bridal Couture' : `${title} · Annika Palermo`;
const nav = [['/designs/', 'Designs'], ['/portfolio/', 'Portfolio'], ['/about/', 'About'], ['/contact/', 'Book a consultation']];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{fullTitle}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml">
    <link rel="sitemap" href={url('/sitemap-index.xml')}>
    <meta name="theme-color" content="#f8f3ec">
    <meta property="og:type" content={type}>
    <meta property="og:site_name" content="Annika Palermo">
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta name="twitter:card" content="summary_large_image">
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="sample-banner" role="note">Sample website: the designer, gowns and posts are fictional.</div>
    <header class="site-header">
      <a class="wordmark" href={url('/')}>Annika Palermo<span>Bridal Couture</span></a>
      <nav aria-label="Main">
        <ul>
          {nav.map(([href, label]) => (
            <li><a href={url(href)} aria-current={path.startsWith(href) ? 'page' : undefined} class={href === '/contact/' ? 'nav-cta' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="wordmark small">Annika Palermo</p>
      <p>Couture wedding gowns, designed and made by hand. Consultations by appointment.</p>
      <p class="muted">&copy; {new Date().getFullYear()} Annika Palermo · Sample site. Illustrations are original artwork made for this site.</p>
    </footer>
  </body>
</html>
