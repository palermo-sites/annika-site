---
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/600.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '../styles/global.css';
import { base, url } from '../lib';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  accent?: string;
  home?: boolean;
  placeholder?: boolean;
}
const {
  title,
  description = 'Placeholder sketchbook of dress studies by Annika Palermo. Sample site.',
  image = '/images/og.png',
  type = 'website',
  accent,
  home = false,
  placeholder = false,
} = Astro.props;
const path = Astro.url.pathname.slice(base.length) || '/';
const canonical = new URL(path, Astro.site);
const imagePath = image.startsWith('/') ? url(image) : image;
const ogImage = new URL(imagePath, Astro.site);
const staging = import.meta.env.PUBLIC_STAGING === 'true';
const fullTitle = home || title === 'Annika Palermo' ? 'Annika Palermo · Dress studies' : `${title} · Annika Palermo`;
const notes = [staging ? 'UAT, not live' : null, placeholder ? 'Placeholder' : null].filter(Boolean);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{fullTitle}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonical}>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml">
    <link rel="sitemap" href={url('/sitemap-index.xml')}>
    {staging && <meta name="robots" content="noindex, nofollow">}
    <meta name="theme-color" content="#f4efe6">
    <meta property="og:type" content={type}>
    <meta property="og:site_name" content="Annika Palermo">
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta name="twitter:card" content="summary_large_image">
  </head>
  <body class:list={[{ 'has-accent': Boolean(accent) }]} style={accent ? `--accent:${accent}` : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    {staging && <div class="uat-banner" role="note"><strong>UAT, not live.</strong> This preview is not the published site.</div>}
    <header class="mast wrap">
      <div class="mast-id">
        {home ? (
          <h1 class="wordmark"><a href={url('/')}>Annika Palermo</a></h1>
        ) : (
          <a class="wordmark" href={url('/')}>Annika Palermo</a>
        )}
        <p class="tagline">from first pencil line to finished frock — a sketchbook in progress</p>
      </div>
      {notes.length > 0 && <p class="chip">{notes.join(' · ')}</p>}
    </header>
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer-name">Annika Palermo</p>
      <p>Dress studies from a sketchbook in progress. The pieces here are placeholders until real work replaces them.</p>
      <p class="fine">&copy; {new Date().getFullYear()} Annika Palermo · Sample site. Drawings are original artwork made for this site.</p>
    </footer>
  </body>
</html>
